{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saymivo.local/schema/script-storyboard.schema.json",
  "title": "Saymivo script storyboard",
  "description": "Shot plan saved next to a project as <projectId>.storyboard.json. Version 2 adds voiceSaid, pictureAdds and screenKeeps. Version 1 files are still accepted by the loader and upgraded on save. timeRange is null until alignment. charRange indexes sourceText; wordRange indexes words.",
  "type": "object",
  "required": ["version", "kind", "source", "sourceText", "words", "shots", "align"],
  "properties": {
    "version": {"enum": [1, 2]},
    "kind": {"const": "script-storyboard"},
    "source": {"enum": ["script", "transcript"]},
    "sourceText": {"type": "string"},
    "align": {
      "type": ["object", "null"],
      "required": ["leadMs", "keepsKey", "clock"],
      "properties": {
        "leadMs": {"type": "number"},
        "keepsKey": {"type": "string"},
        "clock": {"enum": ["source", "timeline"]}
      },
      "additionalProperties": false
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {"type": "string"},
          "startMs": {"type": ["number", "null"]},
          "endMs": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "items": {"$ref": "#/$defs/shot"}
    },
    "updatedAt": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["id", "text", "role", "emphasis", "assetId", "match", "motions", "note", "charRange", "wordRange", "timeRange", "voiceSaid", "pictureAdds", "screenKeeps", "cues", "typing"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "role": {"enum": ["开场", "痛点", "方案", "结尾"]},
        "emphasis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "style"],
            "properties": {
              "text": {"type": "string"},
              "style": {"enum": ["标红", "荧光笔"]}
            },
            "additionalProperties": false
          }
        },
        "assetId": {"type": ["string", "null"]},
        "match": {
          "type": ["object", "null"],
          "required": ["score", "keywords"],
          "properties": {
            "score": {"type": "number"},
            "keywords": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "motions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["大字回弹", "标红", "荧光笔", "印章", "打字界面", "章节转场"]}
        },
        "note": {"type": "string"},
        "charRange": {"$ref": "#/$defs/range"},
        "wordRange": {"$ref": "#/$defs/range"},
        "timeRange": {
          "description": "Output timeline after fine-cut keeps are applied. Drafts store null.",
          "type": ["object", "null"],
          "required": ["startMs", "endMs"],
          "properties": {
            "startMs": {"type": "number"},
            "endMs": {"type": "number"}
          },
          "additionalProperties": false
        },
        "voiceSaid": {"type": "string"},
        "pictureAdds": {"type": "string"},
        "screenKeeps": {"type": "string"},
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["motion", "atMs", "leadMs", "word", "wordIndex"],
            "properties": {
              "motion": {"enum": ["大字回弹", "标红", "荧光笔", "印章", "打字界面", "章节转场"]},
              "atMs": {"type": "number"},
              "leadMs": {"type": "number"},
              "word": {"type": ["string", "null"]},
              "wordIndex": {"type": ["integer", "null"]}
            },
            "additionalProperties": false
          }
        },
        "typing": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["text", "atMs"],
            "properties": {
              "text": {"type": "string"},
              "atMs": {"type": "number"},
              "wordIndex": {"type": "integer"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "range": {
      "type": ["object", "null"],
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
