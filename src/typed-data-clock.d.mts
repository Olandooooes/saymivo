import type {StoryScene} from './storyboard.mjs';
import type {Clip} from './timeline';
export type TypedClockBinding={sceneId:string;src:string;sha256:string;startMs:number;endMs:number};
export type TypedClockProvenance={kind:'explicit-source'|'illustration';note:string};
export type TypedClockDurationFormat={kind:'mm:ss';minuteDigits:number}|{kind:'seconds';integerDigits:number;decimals:number;rounding:'floor'|'nearest'};
export type TypedClockBase={id:string;label:string;definition:string;provenance:TypedClockProvenance;window:{startMs:number;endMs:number}};
export type TypedClockDuration=TypedClockBase&{kind:'duration';unit:'ms';value:{basis:'source-elapsed'}|{basis:'explicit-range';fromMs:number;toMs:number};format:TypedClockDurationFormat};
export type TypedClockReceipt=TypedClockBase&{kind:'receipt-duration';unit:'ms';receipt:{basis:'unix-epoch-ms'|'explicit-shared-origin-ms';startMs:number;endMs:number};format:TypedClockDurationFormat};
export type TypedClockEvents=TypedClockBase&{kind:'event-count';unit:'count';initialCount:number;eventDefinition:{name:string;criterion:string};events:{id:string;atMs:number}[];format:{kind:'integer';integerDigits:number}};
export type TypedClockTrack=TypedClockDuration|TypedClockReceipt|TypedClockEvents;
export type TypedDataClockConfig={kind:'typed-data-clock';clock:'scene-source-relative-ms';binding:TypedClockBinding;tracks:TypedClockTrack[]};
export type TypedClockContext={sourceIdentity:{src:string;sha256:string;kind:'video';width:number;height:number;durationSec:number};projectionProof?:{rawScene:StoryScene;clips:Clip[];fps:number}};
export type TypedClockFormatResult={text:string|null;displayUnit:'mm:ss'|'s'|'count'|null;maximumText:string|null;issues:string[]};
export type TypedClockTrackState=TypedClockFormatResult&{id:string;kind:TypedClockTrack['kind'];label:string;definition:string;unit:'ms'|'count';provenance:TypedClockProvenance;visible:boolean;phase:'before'|'active'|'after';windowProgress:number;progress:number|null;mode:'source-elapsed'|'explicit-range'|'static-receipt'|'explicit-events';valueMs?:number;receipt?:TypedClockReceipt['receipt'];count?:number;countedEventIds?:string[];eventProgress?:number};
export type TypedDataClockState={status:'blocked'|'data-ready';issues:string[];canApply:false;uiAccepted:false;mediaVerified:false;audioVerified:false;sourceElapsedMs:number|null;tracks:TypedClockTrackState[]};
export function typedDataClockFormatDuration(valueMs:number,format:TypedClockDurationFormat):TypedClockFormatResult;
export function typedDataClockIssues(scene:StoryScene,config:TypedDataClockConfig,context:TypedClockContext):string[];
export function typedDataClockExposure(scene:StoryScene):{startMs:number;endMs:number;speed:number};
export function typedDataClockState(scene:StoryScene,config:TypedDataClockConfig,elapsedSourceMs:number,context:TypedClockContext):TypedDataClockState;
export function typedDataClockAtOutput(scene:StoryScene,config:TypedDataClockConfig,outputMs:number,context:TypedClockContext):TypedDataClockState;
