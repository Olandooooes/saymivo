export type FieldRollState={elapsed:number;copyVisible:boolean;cards:{id:string;rect:StageRect;visible:boolean;opacity:number;phase:'outside'|'entering'|'exiting'|'holding';fields:{id:string;sourceRef:string;label:string;rect:StageRect;labelRect:StageRect;from:string;to:string;phase:'original'|'rolling'|'resolved';settledAtMs:number;completeReadable:boolean;readableValue:string|null;cells:FieldRollCell[]}[]}[];automaticAllowed:false;needsFaceReview:true};
