export function fieldRollProtectedRects(scene:StoryScene,config:FieldRollBoardConfig,viewport:{width:number;height:number},proof?:FieldRollProjectionProof):StageRect[];
export function fieldRollProjectionIssues(scene:StoryScene,config:FieldRollBoardConfig,proof?:FieldRollProjectionProof):string[];
export function fieldRollElapsedAtFrame(scene:StoryScene,frame:number,fps:number):number;
