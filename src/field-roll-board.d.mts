import type {StoryScene} from './storyboard.mjs';
import type {Clip} from './timeline';
import type {StageRect} from './dynamic-mechanisms.mjs';
import type {TextFit} from './text-fit.mjs';
export type FieldRollWindow={atMs:number;endMs:number};
export type FieldRollBinding={sceneId:string;src:string;sha256:string;startMs:number;endMs:number};
export type FieldRollField={id:string;sourceRef:string;label:string;from:string;to:string;rect:StageRect;labelRect:StageRect;rollAtMs:number;cellRollMs:number;staggerMs:number;direction:'up'|'down';provenance:{kind:'translation'|'format'|'authored-update';citation:string;fromLanguage?:string;toLanguage?:string}};
export type FieldRollCard={id:string;rect:StageRect;enterAtMs:number;enterMs:number;exitAtMs:number;exitMs:number;fields:FieldRollField[]};
export type FieldRollBoardConfig={kind:'field-roll-board';clock:'scene-source-relative-ms';binding:FieldRollBinding;copyWindow:FieldRollWindow&{rect:StageRect};titleRect:StageRect;speakerRect:StageRect;cards:FieldRollCard[];protectedAreas?:{label?:string;rect:StageRect}[]};
