export type FieldRollMeasurement={key:string;fontKey:string;fields:FieldRollValueMeasurement[];texts:(FieldRollTextPlan&{fit:TextFit})[]};
export type FieldRollReadiness={status:'blocked'|'waiting'|'ready';issues:string[]};
