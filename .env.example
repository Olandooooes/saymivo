# Gemini — accent detection, B-roll planning, clip arranging.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pexels — stock footage/photo search for Auto B-roll.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: domain words to bias transcription accuracy for YOUR videos,
# e.g. product names, brands, topics you talk about.
# AUTOBROLL_PROMPT=The following is a talking-head video about <your topic>. Proper nouns and brands are capitalized.

# Optional: force the faster-whisper device (default: auto — cuda if torch sees a GPU, else cpu).
# AUTOBROLL_DEVICE=cpu

# Optional: face-aware caption placement (one frame per clip → Gemini). 0 = always use the default position.
# AUTOBROLL_FACE_AWARE=1

# Local Chinese workflow; first ASR downloads this model unless a local path is set.
AUTOBROLL_LANGUAGE=zh
AUTOBROLL_MODEL=small
AUTOBROLL_DEVICE=cpu
AUTOBROLL_FACE_AWARE=0
